From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <nekit1000@gmail.com>
Date: Mon, 30 Mar 2026 00:12:42 +0000
Subject: [PATCH] (halium) ueventd: restore /dev/.coldboot_done creation

Change-Id: Ib117d2eab23cc7407a638320385930458cc008c9
---
 init/coldboot.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/init/coldboot.cpp b/init/coldboot.cpp
index 91bee9d322..eb2e1106b5 100644
--- a/init/coldboot.cpp
+++ b/init/coldboot.cpp
@@ -24,10 +24,14 @@
 #include <android-base/properties.h>
 #include <selinux/android.h>
 #include <selinux/selinux.h>
+#include <fcntl.h>
 #include <sys/stat.h>
+#include <unistd.h>
 
 namespace flags = com::android::ueventd::flags;
 
+#define COLDBOOT_DONE "/dev/.coldboot_done"
+
 namespace android {
 namespace init {
 
@@ -115,6 +119,10 @@ void ColdBoot::Run() {
     runner->Wait();
 
     android::base::SetProperty(kColdBootDoneProp, "true");
+
+    // Halium: create old /dev/.coldboot_done as well since it's relied on by scripts
+    close(open(COLDBOOT_DONE, O_WRONLY | O_CREAT | O_CLOEXEC, 0000));
+
     LOG(INFO) << "Coldboot took " << cold_boot_timer.duration().count() / 1000.0f << " seconds";
 }
 
