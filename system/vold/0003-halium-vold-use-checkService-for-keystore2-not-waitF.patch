From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Tue, 16 Jun 2026 14:56:07 +0300
Subject: [PATCH] (halium) vold: use checkService for keystore2, not
 waitForService

keystore2 is absent on Halium; waitForService blocks indefinitely.
Degrade gracefully when the service is not found.

Change-Id: Ic0b5bd4bb38a135b582c8d29b270652c1fe0640b
---
 Keystore.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/Keystore.cpp b/Keystore.cpp
index fd8a887..7a4aae6 100644
--- a/Keystore.cpp
+++ b/Keystore.cpp
@@ -104,7 +104,9 @@ bool KeystoreOperation::finish(std::string* output) {
 }
 
 Keystore::Keystore() {
-    ::ndk::SpAIBinder binder(AServiceManager_waitForService(keystore2_service_name));
+    // Halium: use checkService (non-blocking) instead of waitForService, which blocks
+    // forever. keystore2 is not present on Halium, so we must degrade gracefully here.
+    ::ndk::SpAIBinder binder(AServiceManager_checkService(keystore2_service_name));
     auto keystore2Service = ks2::IKeystoreService::fromBinder(binder);
 
     if (!keystore2Service) {
@@ -224,7 +226,9 @@ KeystoreOperation Keystore::begin(const std::string& key, const km::Authorizatio
 }
 
 void Keystore::earlyBootEnded() {
-    ::ndk::SpAIBinder binder(AServiceManager_waitForService(maintenance_service_name));
+    // Halium: non-blocking checkService; keystore2 maintenance service is absent, so
+    // waitForService would hang init forever in post-fs-data. Skip gracefully if null.
+    ::ndk::SpAIBinder binder(AServiceManager_checkService(maintenance_service_name));
     auto maint_service = ks2_maint::IKeystoreMaintenance::fromBinder(binder);
 
     if (!maint_service) {
@@ -237,7 +241,8 @@ void Keystore::earlyBootEnded() {
 }
 
 void Keystore::deleteAllKeys() {
-    ::ndk::SpAIBinder binder(AServiceManager_waitForService(maintenance_service_name));
+    // Halium: non-blocking checkService (see earlyBootEnded above).
+    ::ndk::SpAIBinder binder(AServiceManager_checkService(maintenance_service_name));
     auto maint_service = ks2_maint::IKeystoreMaintenance::fromBinder(binder);
 
     if (!maint_service) {
