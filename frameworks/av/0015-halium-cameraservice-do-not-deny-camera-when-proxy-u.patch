From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Fri, 4 Sep 2026 21:35:50 +0300
Subject: [PATCH] (halium) cameraservice: do not deny camera when proxy
 unavailable

CameraServiceProxyWrapper::isCameraDisabled returns true when the
CameraServiceProxy binder is not available, which causes connectDevice
to fail with "Camera disabled by device policy" in Halium where the
Android device policy service is not running.

Return false (not disabled) when the proxy is unavailable.

Change-Id: I9a3b5c7d8e1f2a4b6c8d0e2f4a6b8c0d2e4f6a8
---
 .../libcameraservice/utils/CameraServiceProxyWrapper.cpp       | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/services/camera/libcameraservice/utils/CameraServiceProxyWrapper.cpp b/services/camera/libcameraservice/utils/CameraServiceProxyWrapper.cpp
index e14b24bdf4..0cf9b9d181 100644
--- a/services/camera/libcameraservice/utils/CameraServiceProxyWrapper.cpp
+++ b/services/camera/libcameraservice/utils/CameraServiceProxyWrapper.cpp
@@ -498,7 +498,8 @@ void CameraServiceProxyWrapper::logClose(const std::string& id, int32_t latencyM
 
 bool CameraServiceProxyWrapper::isCameraDisabled(int userId) {
     sp<ICameraServiceProxy> proxyBinder = getCameraServiceProxy();
-    if (proxyBinder == nullptr) return true;
+    // Halium: CameraServiceProxy is not available; assume camera is not disabled.
+    if (proxyBinder == nullptr) return false;
     bool ret = false;
     auto status = proxyBinder->isCameraDisabled(userId, &ret);
     if (!status.isOk()) {
