diff --git a/halium_ignored.go b/halium_ignored.go
new file mode 100644
index 0000000..330f0de
--- /dev/null
+++ b/halium_ignored.go
@@ -0,0 +1,93 @@
+// Halium: silently swallow dependencies on modules that match a configurable
+// allowlist. This lets us delete entire Java-only repos (or individual
+// Android.bp entries) from the Halium manifest without chasing every
+// transitive reference. Loaded lazily on first use.
+//
+// Sources, in order:
+//  1. A small hardcoded baseline below.
+//  2. Patterns from $TOP/build/soong/halium_ignored_modules.list, one per line,
+//     blank lines and lines starting with '#' ignored. Patterns use
+//     filepath.Match semantics ('*', '?', '[abc]').
+//
+// $TOP is taken from $TOP, then $ANDROID_BUILD_TOP, then the current working
+// directory (Soong is normally invoked from the tree root, so '.' works).
+
+package blueprint
+
+import (
+	"bufio"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+)
+
+var haliumBaselinePatterns = []string{
+	// Intentionally empty; populate halium_ignored_modules.list in the tree.
+}
+
+var (
+	haliumPatternsOnce sync.Once
+	haliumPatterns     []string
+)
+
+func haliumLoadPatterns() {
+	haliumPatterns = append(haliumPatterns, haliumBaselinePatterns...)
+
+	top := os.Getenv("TOP")
+	if top == "" {
+		top = os.Getenv("ANDROID_BUILD_TOP")
+	}
+	if top == "" {
+		// soong_build is invoked via "env -i $BUILDER --top <tree-root> ..."
+		// which clears all environment variables, so fall back to parsing os.Args.
+		for i, arg := range os.Args {
+			if arg == "--top" && i+1 < len(os.Args) {
+				top = os.Args[i+1]
+				break
+			}
+		}
+	}
+	if top == "" {
+		top = "."
+	}
+	path := filepath.Join(top, "build", "soong", "halium_ignored_modules.list")
+
+	f, err := os.Open(path)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		haliumPatterns = append(haliumPatterns, line)
+	}
+}
+
+// haliumIgnored reports whether depName matches a pattern in the Halium
+// ignore list. Safe for concurrent use.
+func haliumIgnored(depName string) bool {
+	haliumPatternsOnce.Do(haliumLoadPatterns)
+	if len(haliumPatterns) == 0 {
+		return false
+	}
+	// Strip any "{variant}" suffix the caller may have appended for diagnostics.
+	if i := strings.IndexByte(depName, '{'); i >= 0 {
+		depName = depName[:i]
+	}
+	for _, p := range haliumPatterns {
+		if ok, _ := filepath.Match(p, depName); ok {
+			return true
+		}
+		// Allow exact matches without glob syntax.
+		if p == depName {
+			return true
+		}
+	}
+	return false
+}
