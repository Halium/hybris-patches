From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Wed, 15 Jul 2026 11:45:03 +0300
Subject: [PATCH] (halium) Skip unknown module types via halium_ignored

Module types defined by soong plugins in trimmed repos (e.g. csuite_test
from test/app_compat/csuite) would fail parsing with "unrecognized
module type". Skip such definitions when the type name matches the
halium_ignored_modules.list patterns.

Change-Id: I613a80550619e1152d05ab85b05a3d879fe0d0cb
---
 context.go        | 6 ++++++
 halium_ignored.go | 4 +++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/context.go b/context.go
index 37e949b..a89dbc4 100644
--- a/context.go
+++ b/context.go
@@ -1882,6 +1882,12 @@ func processModuleDef(moduleDef *parser.Module,
 			return nil, nil
 		}
 
+		// Halium: skip definitions whose module type comes from a soong
+		// plugin in a repo trimmed from the manifest (e.g. csuite_test).
+		if haliumIgnored(moduleDef.Type) {
+			return nil, nil
+		}
+
 		return nil, []error{
 			&BlueprintError{
 				Err: fmt.Errorf("unrecognized module type %q", moduleDef.Type),
diff --git a/halium_ignored.go b/halium_ignored.go
index 330f0de..3b4dc51 100644
--- a/halium_ignored.go
+++ b/halium_ignored.go
@@ -1,7 +1,9 @@
 // Halium: silently swallow dependencies on modules that match a configurable
 // allowlist. This lets us delete entire Java-only repos (or individual
 // Android.bp entries) from the Halium manifest without chasing every
-// transitive reference. Loaded lazily on first use.
+// transitive reference. Unknown module types matching the list are also
+// skipped at parse time (for module types defined by soong plugins in
+// trimmed repos, e.g. csuite_test). Loaded lazily on first use.
 //
 // Sources, in order:
 //  1. A small hardcoded baseline below.
