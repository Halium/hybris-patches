From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheKit <thekit@disroot.org>
Date: Wed, 15 Jul 2026 12:54:14 +0300
Subject: [PATCH] (halium) java: add keep-list for host codegen tools

Device cc modules invoke some Java host tools at build time (xsdc via
xsd_config), so those and their Java deps must not be disabled by the
halium_disable_java mutator. Keep modules matching
halium_kept_java_modules.list; seed it with xsdc and commons-cli-1.2.

Change-Id: I390fd630b604e03336d737c6dee6e174657142d1
---
 halium_kept_java_modules.list | 19 ++++++++
 java/halium_noop.go           | 81 +++++++++++++++++++++++++++++++++++
 2 files changed, 100 insertions(+)
 create mode 100644 halium_kept_java_modules.list

diff --git a/halium_kept_java_modules.list b/halium_kept_java_modules.list
new file mode 100644
index 000000000..6083f577c
--- /dev/null
+++ b/halium_kept_java_modules.list
@@ -0,0 +1,19 @@
+# Halium kept Java modules list.
+#
+# Java modules matching these patterns are NOT disabled by the
+# halium_disable_java mutator. Use this for host codegen tools that device
+# modules invoke at build time, plus their Java dependencies.
+#
+# One pattern per line, filepath.Match semantics, '#' comments.
+
+# XSD-to-code compiler; cc modules use it via xsd_config (e.g. apexd's
+# apex-info-list, audio policy / media profiles configs).
+xsdc
+commons-cli-1.2
+
+# APK/APEX signer; apexer signs every apex (e.g. com.android.adbd) with it.
+signapk
+apksig
+bouncycastle-unbundled
+bouncycastle-bcpkix-unbundled
+conscrypt-unbundled
diff --git a/java/halium_noop.go b/java/halium_noop.go
index 15d962428..689099bb8 100644
--- a/java/halium_noop.go
+++ b/java/halium_noop.go
@@ -21,6 +21,12 @@
 package java
 
 import (
+	"bufio"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
 	"android/soong/android"
 )
 
@@ -28,9 +34,84 @@ func init() {
 	android.PreArchMutators(func(ctx android.RegisterMutatorsContext) {
 		ctx.BottomUp("halium_disable_java", haliumDisableJavaMutator)
 	})
+	// Re-run soong analysis when the Halium list files change; they are read
+	// at runtime and otherwise invisible to the incremental build.
+	android.InitRegistrationContext.RegisterParallelSingletonType("halium_list_deps",
+		func() android.Singleton { return &haliumListDepsSingleton{} })
+}
+
+type haliumListDepsSingleton struct{}
+
+func (s *haliumListDepsSingleton) GenerateBuildActions(ctx android.SingletonContext) {
+	top := haliumTop()
+	ctx.AddNinjaFileDeps(
+		filepath.Join(top, "build", "soong", "halium_ignored_modules.list"),
+		filepath.Join(top, "build", "soong", "halium_kept_java_modules.list"),
+	)
+}
+
+// Keep-list of Java modules that must stay enabled: host codegen tools (and
+// their Java deps) that device modules invoke at build time, e.g. xsdc.
+// Patterns come from $TOP/build/soong/halium_kept_java_modules.list, one per
+// line, filepath.Match semantics, '#' comments.
+var (
+	haliumKeptOnce     sync.Once
+	haliumKeptPatterns []string
+)
+
+func haliumTop() string {
+	top := os.Getenv("TOP")
+	if top == "" {
+		top = os.Getenv("ANDROID_BUILD_TOP")
+	}
+	if top == "" {
+		// soong_build is invoked via "env -i $BUILDER --top <tree-root> ..."
+		// which clears all environment variables, so fall back to parsing os.Args.
+		for i, arg := range os.Args {
+			if arg == "--top" && i+1 < len(os.Args) {
+				top = os.Args[i+1]
+				break
+			}
+		}
+	}
+	if top == "" {
+		top = "."
+	}
+	return top
+}
+
+func haliumLoadKept() {
+	f, err := os.Open(filepath.Join(haliumTop(), "build", "soong", "halium_kept_java_modules.list"))
+	if err != nil {
+		return
+	}
+	defer f.Close()
+
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		haliumKeptPatterns = append(haliumKeptPatterns, line)
+	}
+}
+
+func haliumKeptJava(name string) bool {
+	haliumKeptOnce.Do(haliumLoadKept)
+	for _, p := range haliumKeptPatterns {
+		if ok, _ := filepath.Match(p, name); ok || p == name {
+			return true
+		}
+	}
+	return false
 }
 
 func haliumDisableJavaMutator(ctx android.BottomUpMutatorContext) {
+	if haliumKeptJava(ctx.ModuleName()) {
+		return
+	}
+
 	switch ctx.Module().(type) {
 	// java.go
 	case *Library,
