diff --git a/java/halium_noop.go b/java/halium_noop.go
new file mode 100644
index 000000000..15d962428
--- /dev/null
+++ b/java/halium_noop.go
@@ -0,0 +1,144 @@
+// Halium: disable all Java module types so they produce no build actions and
+// no dependency edges. This eliminates the arch/OS variant explosion and the
+// transitive Java dep graph, reducing Soong's initial-scan RAM significantly.
+//
+// Two mechanisms work together:
+//  1. This pre-arch mutator calls Disable() on every Java module before the
+//     OS and arch transition mutators run. The arch.go Split() functions
+//     (patched separately) short-circuit to a single variant for disabled
+//     modules, preventing the variant explosion.
+//  2. android/mutator.go's depsMutator already guards behind m.Enabled(), so
+//     DepsMutator() is never called on disabled modules.
+//  3. android/module.go's GenerateBuildActions already guards behind
+//     m.Enabled(), so GenerateAndroidBuildActions() is never called either.
+//
+// APEXes and other consumers that list Java modules in their java_libs /
+// bootclasspath_fragments / etc. properties will have those dependencies
+// silently dropped by the blueprint allowlist patch in
+// build/blueprint/halium_ignored.go (combined with an entry in
+// build/soong/halium_ignored_modules.list).
+
+package java
+
+import (
+	"android/soong/android"
+)
+
+func init() {
+	android.PreArchMutators(func(ctx android.RegisterMutatorsContext) {
+		ctx.BottomUp("halium_disable_java", haliumDisableJavaMutator)
+	})
+}
+
+func haliumDisableJavaMutator(ctx android.BottomUpMutatorContext) {
+	switch ctx.Module().(type) {
+	// java.go
+	case *Library,
+		*Test,
+		*TestHost,
+		*TestHelperLibrary,
+		*JavaTestImport,
+		*Import,
+		*DexImport,
+		*ApiLibrary,
+		*JavaApiContribution,
+		*JavaApiContributionImport,
+		*Binary,
+		*GenruleCombiner,
+		*GeneratedJavaLibraryModule:
+
+	// app.go
+	case *AndroidApp,
+		*AndroidTest,
+		*AndroidTestHelperApp,
+		*OverrideAndroidApp,
+		*OverrideAndroidTest:
+
+	// aar.go
+	case *AndroidLibrary,
+		*AARImport:
+
+	// app_import.go
+	case *AndroidAppImport,
+		*AndroidTestImport:
+
+	// app_set.go
+	case *AndroidAppSet:
+
+	// bootclasspath_fragment.go
+	case *BootclasspathFragmentModule,
+		*PrebuiltBootclasspathFragmentModule:
+
+	// dexpreopt_bootjars.go
+	case *artBootImages,
+		*dexpreoptBootJars:
+
+	// dexpreopt_check.go
+	case *dexpreoptSystemserverCheck:
+
+	// device_host_converter.go
+	case *DeviceForHost,
+		*HostForDevice:
+
+	// droiddoc.go
+	case *Javadoc,
+		*Droiddoc,
+		*ExportedDroiddocDir:
+
+	// droidstubs.go
+	case *Droidstubs,
+		*PrebuiltStubsSources:
+
+	// fuzz.go
+	case *JavaFuzzTest:
+
+	// platform_bootclasspath.go
+	case *platformBootclasspathModule:
+
+	// platform_compat_config.go
+	case *platformCompatConfig,
+		*prebuiltCompatConfigModule,
+		*globalCompatConfig:
+
+	// plugin.go
+	case *Plugin,
+		*KotlinPlugin:
+
+	// prebuilt_apis.go
+	case *prebuiltApis:
+
+	// ravenwood.go
+	case *ravenwoodTest,
+		*ravenwoodLibgroup:
+
+	// robolectric.go
+	case *robolectricTest,
+		*robolectricRuntimes:
+
+	// rro.go
+	case *RuntimeResourceOverlay,
+		*OverrideRuntimeResourceOverlay,
+		*AutogenRuntimeResourceOverlay:
+
+	// sdk_library.go
+	case *SdkLibrary,
+		*SdkLibraryImport:
+
+	// sdk_library_internal.go
+	case *sdkLibraryXml:
+
+	// system_modules.go
+	case *SystemModules,
+		*systemModulesImport:
+
+	// systemserver_classpath_fragment.go
+	case *platformSystemServerClasspathModule,
+		*SystemServerClasspathModule,
+		*prebuiltSystemServerClasspathModule:
+
+	default:
+		return
+	}
+
+	ctx.Module().Disable()
+}
