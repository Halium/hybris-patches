new file mode 100644
index 000000000..e4b0fd28b
--- /dev/null
+++ b/ci_tests/halium_noop.go
@@ -0,0 +1,22 @@
+// Halium: disable test_package (CI test-zip) modules. Halium does not need
+// CI test packaging, and the tests listed in these modules come from Java app
+// packages that are not in the Halium manifest, which would cause dependency
+// resolution errors if DepsMutator were allowed to run.
+
+package ci_tests
+
+import (
+	"android/soong/android"
+)
+
+func init() {
+	android.PreArchMutators(func(ctx android.RegisterMutatorsContext) {
+		ctx.BottomUp("halium_disable_ci_tests", haliumDisableCITestsMutator)
+	})
+}
+
+func haliumDisableCITestsMutator(ctx android.BottomUpMutatorContext) {
+	if _, ok := ctx.Module().(*testPackageZip); ok {
+		ctx.Module().Disable()
+	}
+}
