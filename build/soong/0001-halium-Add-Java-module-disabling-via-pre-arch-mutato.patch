diff --git a/android/paths.go b/android/paths.go
index cbd2ab435..68b92e42e 100644
--- a/android/paths.go
+++ b/android/paths.go
@@ -687,9 +687,22 @@ func (p OutputPaths) Strings() []string {
 func getPathsFromModuleDep(ctx ModuleWithDepsPathContext, path, moduleName, tag string) (Paths, error) {
 	module := GetModuleProxyFromPathDep(ctx, moduleName, tag)
 	if module.IsNil() {
+		// Halium: when a dep was silently dropped (disabled Java no-op or absent
+		// from manifest) the dep edge does not exist. Under AllowMissingDependencies
+		// return empty paths so the source list is pruned rather than emitting a
+		// Ninja error rule.
+		if ctx.Config().AllowMissingDependencies() {
+			return nil, nil
+		}
 		return nil, missingDependencyError{[]string{moduleName}}
 	}
 	if !OtherModulePointerProviderOrDefault(ctx, module, CommonModuleInfoProvider).Enabled {
+		// Halium: dep module exists in graph but is disabled (e.g. Java no-op).
+		// Under AllowMissingDependencies silently return empty rather than emitting
+		// a Ninja error rule for the missing output files.
+		if ctx.Config().AllowMissingDependencies() {
+			return nil, nil
+		}
 		return nil, missingDependencyError{[]string{moduleName}}
 	}
 
