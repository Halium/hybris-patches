diff --git a/halium_ignored_modules.list b/halium_ignored_modules.list
new file mode 100644
index 000000000..9ed1719ce
--- /dev/null
+++ b/halium_ignored_modules.list
@@ -0,0 +1,125 @@
+# Halium ignored modules list.
+#
+# One pattern per line. Blank lines and lines starting with '#' are ignored.
+# Patterns use filepath.Match semantics: '*' matches any run of non-/, '?'
+# matches one char, '[abc]' matches a character class. No '/' is involved
+# here so '*' effectively matches anything within a name.
+#
+# A name that matches any pattern is silently dropped from dependency
+# resolution: references to it produce no error, and dependents see no
+# corresponding child in their dep graph. Use this to delete entire Java
+# repos / Android.bp entries from the Halium manifest without chasing
+# every transitive reference.
+#
+# Start conservative; expand as build failures reveal more names you want
+# silenced. Patterns are scanned in order; first match wins (semantically
+# the same as any match — order has no effect on correctness).
+
+# --- Java core libraries ---
+core-oj
+core-libart
+core-icu4j
+core-icu4j-for-host
+core-all
+core-all-system-modules
+core-lambda-stubs
+core-public-stubs-system-modules
+core-module-lib-stubs-system-modules
+core-system-modules-lint
+core-*-stubs-system-modules
+
+# --- Framework jars and bootclasspath ---
+framework
+framework-*
+framework.*
+*.framework
+ext
+*.ext
+services
+services.*
+android_*_stubs_current
+android_*_stubs_current_exportable
+android_*_stubs_current.from-text
+android.test.*
+android_test_*
+android_system_*
+
+# --- Bootclasspath / systemserverclasspath fragments ---
+*-bootclasspath-fragment
+*.bootclasspath-fragment
+*-systemserverclasspath-fragment
+*.systemserverclasspath-fragment
+platform-bootclasspath
+platform-systemserverclasspath
+
+# --- API surfaces / stubs / lint ---
+*-stubs
+*-stubs.*
+*.stubs
+*.stubs.*
+*-api
+*-api.*
+api-stubs-*
+*-api-stubs-*
+*.api
+metalava
+metalava-*
+
+# --- Kotlin / Java toolchains commonly pulled in ---
+kotlin-*
+kotlinx-*
+kotlin_*
+kotlinx_*
+
+# --- ART / dexpreopt artifacts ---
+art
+art.*
+art-*
+*.art
+dex2oat*
+profman*
+oatdump*
+
+# --- Crypto / TLS Java libs ---
+conscrypt
+conscrypt.*
+conscrypt-*
+bouncycastle
+bouncycastle.*
+bouncycastle-*
+
+# --- AndroidX / Jetpack ---
+androidx.*
+androidx-*
+
+# --- Java aconfig modules (from packages not in Halium manifest) ---
+# These are generated java_aconfig_library targets; their names are package-
+# qualified (e.g. com.android.eyedropper.flags-aconfig-java) and cannot be
+# covered by the haliumDisabled variant check because the source package is
+# absent entirely.
+*-aconfig-java
+*-aconfig-java.*
+*_aconfig_java
+*_aconfig_java_*
+
+# --- Java/app defaults modules (from packages not in Halium manifest) ---
+# These are android_defaults / java_defaults that live in un-checked-out repos.
+# The modules that reference them are Java apps (also disabled), so silencing
+# the missing-dep error is safe.
+*_defaults
+*-defaults
+
+# --- Misc Java-only ---
+okhttp
+okhttp-*
+ext-*
+icu4j-*
+robolectric*
+tradefed*
+junit*
+hamcrest*
+mockito*
+truth*
+google-*
+*.test
+*.tests
